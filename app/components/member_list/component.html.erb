<ul class="list bg-base-100 border-base-300 rounded-box border">
  <% memberships.each do |membership| %>
    <li class="list-row flex-wrap items-center gap-y-3">
      <div class="min-w-0 grow">
        <span class="truncate font-medium"><%= membership.user.email %></span>

        <% if own?(membership) %>
          <span class="badge badge-ghost badge-xs ms-1">You</span>
        <% end %>
      </div>

      <% if manageable? %>
        <%= form_with model: membership,
                      url: helpers.organization_membership_path(organization, membership),
                      method: :patch,
                      class: 'flex items-center gap-2' do |form| %>
          <%#
            Every row's form is scoped to `membership`, so the ids Rails derives
            would be the same one over and over - and each row's label would
            point at the first row's select.
          %>

          <%= form.label :role, "Role of #{membership.user.email}",
                         class: 'sr-only',
                         for: role_field_id(membership) %>

          <%= form.select :role,
                          role_options,
                          {},
                          class: 'select select-sm w-28',
                          id: role_field_id(membership) %>

          <%= form.submit 'Save', class: 'btn btn-sm' %>
        <% end %>
        <%= button_to helpers.organization_membership_path(organization, membership),
                      method: :delete,
                      class: 'btn btn-ghost btn-sm text-error',
                      form: { data: { turbo_confirm: confirm_text(membership) } } do %>
          <span class="size-4 <%= remove_icon(membership) %>" aria-hidden="true"></span>

          <span class="sr-only"><%= remove_label(membership) %></span>
        <% end %>
      <% else %>
        <%= render RoleBadge::Component.new(role: membership.role) %>
      <% end %>
    </li>
  <% end %>
</ul>
