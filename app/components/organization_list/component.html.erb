<% if organizations.empty? %>
  <div class="border-base-300 bg-base-100 rounded-box border border-dashed p-10 text-center">
    <span class="icon-[lucide--building-2] text-base-content/30 size-10" aria-hidden="true"></span>

    <p class="mt-4 font-medium">You are not a member of any organization yet</p>

    <p class="text-base-content/60 mx-auto mt-1 max-w-sm text-sm text-pretty">
      Create one to get your own space, or ask an admin of an existing organization to add you by the email address you
      signed up with.
    </p>

    <%= link_to 'Create an organization', helpers.new_organization_path, class: 'btn btn-primary mt-6' %>
  </div>
<% else %>
  <ul class="list bg-base-100 border-base-300 rounded-box border">
    <% organizations.each do |organization| %>
      <li class="list-row items-center">
        <div class="min-w-0">
          <%= link_to organization.name,
                      helpers.organization_root_path(organization),
                      class: 'link link-hover font-medium' %>

          <%# The slug is the URL, so it is worth showing where a link will lead %>
          <p class="text-base-content/50 truncate font-mono text-xs">/org/<%= organization.slug %></p>
        </div>

        <%= link_to helpers.organization_root_path(organization), class: 'btn btn-ghost btn-sm ms-auto' do %>
          Open
          <span class="icon-[lucide--arrow-right] size-4" aria-hidden="true"></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
