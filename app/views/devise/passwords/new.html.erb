<%= render PageTitle::Component.new('Forgot your password?') do %>
  Enter the address you signed up with and we will send you a link to set a new password.
<% end %>

<div class="bg-base-100 border-base-300 rounded-box mx-auto max-w-md border p-6">
  <%= render 'devise/shared/error_messages', resource: resource %>

  <%= form_with model: resource, as: resource_name, url: password_path(resource_name) do |form| %>
    <fieldset class="fieldset">
      <%= form.label :email, class: 'fieldset-legend' %>

      <%= form.email_field :email, class: 'input w-full', autofocus: true, autocomplete: 'email', required: true %>
    </fieldset>

    <%= form.submit 'Send reset instructions', class: 'btn btn-primary mt-4 w-full' %>
  <% end %>

  <%= render 'devise/shared/links' %>
</div>
