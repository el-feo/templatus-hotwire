<%#
  Only the links for the Devise modules this app enables. Turning on
  :confirmable, :lockable or :omniauthable means adding theirs back - the
  generated partial this replaced has an example of each.
%>

<div class="text-base-content/70 mt-6 flex flex-wrap justify-center gap-x-4 gap-y-1 text-sm">
  <% if controller_name != 'sessions' %>
    <%= link_to 'Sign in', new_session_path(resource_name), class: 'link link-hover' %>
  <% end %>

  <% if controller_name != 'registrations' %>
    <%= link_to 'Create an account', new_registration_path(resource_name), class: 'link link-hover' %>
  <% end %>

  <% if controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to 'Forgot your password?', new_password_path(resource_name), class: 'link link-hover' %>
  <% end %>
</div>
