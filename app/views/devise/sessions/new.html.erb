<%= render PageTitle::Component.new('Sign in') do %>
  Signing in takes you to your organizations.
<% end %>

<div class="bg-base-100 border-base-300 rounded-box mx-auto max-w-md border p-6">
  <%= form_with model: resource, as: resource_name, url: session_path(resource_name) do |form| %>
    <fieldset class="fieldset">
      <%= form.label :email, class: 'fieldset-legend' %>

      <%= form.email_field :email, class: 'input w-full', autofocus: true, autocomplete: 'email', required: true %>
    </fieldset>

    <fieldset class="fieldset">
      <%= form.label :password, class: 'fieldset-legend' %>

      <%= form.password_field :password, class: 'input w-full', autocomplete: 'current-password', required: true %>
    </fieldset>

    <% if devise_mapping.rememberable? %>
      <label class="label mt-2 cursor-pointer justify-start gap-2">
        <%= form.check_box :remember_me, class: 'checkbox checkbox-sm' %>
        <span>Remember me</span>
      </label>
    <% end %>

    <%= form.submit 'Sign in', class: 'btn btn-primary mt-4 w-full' %>
  <% end %>

  <%= render 'devise/shared/links' %>
</div>
